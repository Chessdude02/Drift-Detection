# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_DEFAULT_ARTIFACT_ROOT=./mlruns
MODEL_NAME=cmapss_rul
MODEL_STAGE=Production

# Data
DATA_DIR=./data

# Serving
SERVING_PORT=8000
MODEL_REFRESH_SECONDS=300
INFERENCE_LOG_DB=./inference_log.db

# Drift
DRIFT_THRESHOLD=0.5
DRIFT_REFERENCE_PATH=./data/processed/reference.parquet
PROMETHEUS_PUSHGATEWAY_URL=http://localhost:9091

# Retrain trigger (in-cluster only)
KUBE_NAMESPACE=pdm
RETRAIN_CRONJOB_NAME=pdm-retrain
